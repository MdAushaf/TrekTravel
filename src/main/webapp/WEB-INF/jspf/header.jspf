<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.*" %>
<%@ page import="java.time.*" %>
<%@ page import="java.math.*" %>
<%@ page import="com.trektravel.model.*" %>
<%@ page import="com.trektravel.util.*" %>
<%
    User currentUser = (User) session.getAttribute("currentUser");
    if (currentUser == null) {
        currentUser = (User) session.getAttribute("user");
    }
    String successMsg = (String) session.getAttribute("successMessage");
    if (successMsg == null) {
        successMsg = (String) session.getAttribute("flash_success");
    }
    String errorMsg = (String) session.getAttribute("errorMessage");
    if (errorMsg == null) {
        errorMsg = (String) session.getAttribute("flash_error");
    }
    if (errorMsg == null) {
        errorMsg = (String) request.getAttribute("errorMessage");
    }
    if (errorMsg == null) {
        errorMsg = (String) request.getAttribute("msgError");
    }
    if (successMsg == null) {
        successMsg = (String) request.getAttribute("msgSuccess");
    }
    session.removeAttribute("successMessage");
    session.removeAttribute("flash_success");
    session.removeAttribute("errorMessage");
    session.removeAttribute("flash_error");
    String cp = request.getContextPath();
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrekTravel — Climb Higher. Travel Smarter.</title>
    <!-- Bootstrap 5.3 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="<%= cp %>/css/style.css">
</head>
<body>

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-dark navbar-trektravel sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="<%= cp %>/">
            <span>🏔️</span> TrekTravel
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="<%= cp %>/search">🔍 Explore Treks</a>
                </li>

                <% if (currentUser != null && currentUser.isTrekker()) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/trekker/bookings">🎒 My Bookings</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/trekker/profile">🪪 Trekker Profile</a>
                    </li>
                <% } else if (currentUser != null && currentUser.isOrganizer()) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/organizer/treks">⛺ My Treks</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/organizer/bookings">📋 Participants</a>
                    </li>
                <% } else if (currentUser != null && currentUser.isAdmin()) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/admin/dashboard">📊 Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/admin/profiles">🪪 Verifications</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/admin/treks">🏔️ Trek Approvals</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/admin/users">👥 Users</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<%= cp %>/admin/bookings">📑 Bookings</a>
                    </li>
                <% } %>
            </ul>

            <div class="d-flex align-items-center gap-2">
                <% if (currentUser == null) { %>
                    <a href="<%= cp %>/login" class="btn btn-outline-light btn-sm">Log In</a>
                    <a href="<%= cp %>/register" class="btn btn-tt-accent btn-sm">Register</a>
                <% } else { %>
                    <span class="text-light me-2 small">
                        <strong><%= H.e(currentUser.getName()) %></strong>
                        <span class="badge bg-light text-dark ms-1"><%= H.e(currentUser.getRole()) %></span>
                    </span>
                    <form method="post" action="<%= cp %>/logout" class="d-inline m-0">
                        <%= H.csrf(session) %>
                        <button type="submit" class="btn btn-outline-light btn-sm" data-confirm="Are you sure you want to log out?">Logout</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>
</nav>

<!-- System Flash Alerts -->
<div class="container mt-3">
    <% if (successMsg != null && !successMsg.trim().isEmpty()) { %>
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <span class="me-2">✅</span>
            <div><%= H.e(successMsg) %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (errorMsg != null && !errorMsg.trim().isEmpty()) { %>
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <span class="me-2">⚠️</span>
            <div><%= H.e(errorMsg) %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>

<main class="py-4">
