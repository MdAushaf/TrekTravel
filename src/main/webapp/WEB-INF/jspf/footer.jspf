                    <li class="mb-2"><a href="<%= cp %>/search?difficulty=EASY">Beginner Friendly Treks</a></li>
                    <li class="mb-2"><a href="<%= cp %>/search?difficulty=MODERATE">Moderate Challenges</a></li>
                    <li class="mb-2"><a href="<%= cp %>/register">Join as an Operator</a></li>
                </ul>
            </div>
            <div class="col-md-4 col-6">
                <h6 class="text-white text-uppercase fw-bold mb-3 small">Safety & Verified Trekkers</h6>
                <p class="small text-secondary mb-2">
                    Submit your government ID proof and emergency contacts to unlock exclusive <strong>Verified Trekker discounts</strong> and seamless slot booking.
                </p>
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                    🛡️ Verified Wilderness Safety First
                </span>
            </div>
        </div>
        <hr class="border-secondary opacity-25">
        <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary">
            <div>&copy; 2026 TrekTravel Inc. All rights reserved.</div>
            <div>Built with Jakarta Servlets 6.0 &amp; MySQL 8.0 on Apache Tomcat 10.1</div>
        </div>
    </div>
</footer>

