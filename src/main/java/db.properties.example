# TrekTravel Database & Application Configuration Example
# Copy this file to db.properties and set your local MySQL password

db.url=jdbc:mysql://localhost:3306/trektravel?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.user=root
db.password=YOUR_MYSQL_PASSWORD_HERE

# Uploads directory for Trekker ID proof documents (Govt-ID)
# Defaults to <user.home>/trektravel_uploads if left empty
upload.dir=
